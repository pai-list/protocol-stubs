    { "pattern": "earn.axiomid.app/*", "zone_name": "axiomid.app" },
    { "pattern": "jobs.axiomid.app/*", "zone_name": "axiomid.app" },
    { "pattern": "ppp.axiomid.app/*", "zone_name": "axiomid.app" }
  ]
}